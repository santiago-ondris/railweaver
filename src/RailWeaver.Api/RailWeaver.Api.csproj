<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Thin HTTP layer. Must not contain railway logic; delegates to RailWeaver.Core. -->

  <ItemGroup>
    <ProjectReference Include="..\RailWeaver.Core\RailWeaver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\regions\*.json"
             Link="data\regions\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
