{
  "name": "railweaver-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens": "(echo '/* Generated from DESIGN.md by `npm run tokens`. Do not edit by hand. */' && design.md export ../../DESIGN.md --format css-vars --prefix rw) > src/styles/tokens.generated.css",
    "design:lint": "design.md lint ../../DESIGN.md"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-stencil": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "cesium": "^1.145.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
